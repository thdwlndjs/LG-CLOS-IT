# Copy to an ignored .env file; do not commit populated credentials.
# Use on the independent host only. Host-published ports bind loopback there.
RECOVERY_POSTGRES_USER=wardrobe_recovery
RECOVERY_POSTGRES_PASSWORD=CHANGE_ME
RECOVERY_STORAGE_ACCESS_KEY=CHANGE_ME
RECOVERY_STORAGE_SECRET_KEY=CHANGE_ME
# Eventual API environment; connection switch requires approval.
APP_ENV=local
PUBLIC_DEPLOYMENT=false
VTON_PROVIDER=MOCK
FITROOM_LIVE_ENABLED=false
FITROOM_STATUS_READ_UNBILLED_VERIFIED=false
FITROOM_API_KEY=
STORAGE_PROVIDER=MINIO
STORAGE_BUCKET=wardrobe-assets
DATABASE_URL=postgresql+asyncpg://wardrobe_recovery:CHANGE_ME@127.0.0.1:57433/wardrobe_demo_recovered
REDIS_URL=redis://127.0.0.1:16479/0
CELERY_BROKER_URL=redis://127.0.0.1:16479/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16479/2
STORAGE_ENDPOINT=http://127.0.0.1:19100
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:19100
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
AUTH_MODE=JWT
DEMO_AUTH_ENABLED=true
PUBLIC_DEMO_LOGIN_ENABLED=false
WORKER_EXECUTION=CELERY
